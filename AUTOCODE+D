def pre_auton():
    brain.screen.print("Pre-Autonomous Code Running")
    brain.screen.new_line()
    brain.screen.print("Initializing robot...")
    wait(1, SECONDS)
    brain.screen.clear_screen()
    brain.screen.print("Ready for Competition")

# ===============================
# AUTONOMOUS
# ===============================
def autonomous():
    brain.screen.clear_screen()
    brain.screen.print("Autonomous: Driving Forward 6 inches")

    # Convert 6 inches to motor degrees (4" wheel: 1 rev = 12.566")
    degrees_to_drive = round((6 / 12.566) * 360)

    left_motors.spin_for(FORWARD, degrees_to_drive, DEGREES, 50, PERCENT, False)
    right_motors.spin_for(FORWARD, degrees_to_drive, DEGREES, 50, PERCENT, True)

    left_motors.stop(BRAKE)
    right_motors.stop(BRAKE)

    brain.screen.new_line()
    brain.screen.print("Autonomous Complete")

# ===============================
# DRIVER CONTROL
# ===============================
def usercontrol():
    brain.screen.clear_screen()
    brain.screen.print("Driver Control Active")

    while True:
        # --- Arcade Drive ---
        forward = -controller.axis3.position()
        turn = -controller.axis1.position()

        # Deadband
        if abs(forward) < 5:
            forward = 0
        if abs(turn) < 5:
            turn = 0

        left_speed = forward + turn
        right_speed = forward - turn

        # Clamp speed to [-100, 100]
        left_speed = max(min(left_speed, 100), -100)
        right_speed = max(min(right_speed, 100), -100)

        left_motors.spin(FORWARD, left_speed, PERCENT)
        right_motors.spin(FORWARD, right_speed, PERCENT)

        # --- Arm Motor (R1/R2) ---
        if controller.buttonR2.pressing():
            arm_motor.spin(FORWARD, 100, PERCENT)
        elif controller.buttonR1.pressing():
            arm_motor.spin(REVERSE, 100, PERCENT)
        else:
            arm_motor.stop(HOLD)

        # --- Lift Motor (L1/L2) ---
        if controller.buttonL2.pressing():
            lift_motor.spin(FORWARD, 100, PERCENT)
        elif controller.buttonL1.pressing():
            lift_motor.spin(REVERSE, 100, PERCENT)
        else:
            lift_motor.stop(HOLD)

        wait(0.02, SECONDS)

