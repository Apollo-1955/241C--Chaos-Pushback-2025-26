{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\n# ------------------------------------------\n# \n# \tProject:      241C Robotics Code\n#\tAuthor:       Heer Patel\n#\tCreated:      11/8/2025\n#\tDescription:  Vex autonmous and driver code for Pushback\n# \n# ------------------------------------------\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\n\ndef play_vexcode_sound(sound_name):\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n#endregion VEXcode Generated Robot Configuration\n#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain = Brain()\n\n# Wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n\n# Set random seed\ninitializeRandomSeed()\n\ndef play_vexcode_sound(sound_name):\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\nwait(200, MSEC)\nprint(\"\\033[2J\")\n#endregion\n\n# ===============================\n# USER CONFIGURATION\n# ===============================\n\ncontroller = Controller()\n\n# Drive Motors\nleft_motors = MotorGroup(\n    Motor(Ports.PORT11, GearSetting.RATIO_18_1, False),\n    Motor(Ports.PORT12, GearSetting.RATIO_18_1, False),\n    Motor(Ports.PORT13, GearSetting.RATIO_18_1, False)\n)\n\nright_motors = MotorGroup(\n    Motor(Ports.PORT1, GearSetting.RATIO_18_1, True),\n    Motor(Ports.PORT2, GearSetting.RATIO_18_1, True),\n    Motor(Ports.PORT3, GearSetting.RATIO_18_1, True)\n)\n\n# Arm and Lift Motors\narm_motor = Motor(Ports.PORT4, GearSetting.RATIO_18_1, False)   # R1/R2 control\nlift_motor = Motor(Ports.PORT17, GearSetting.RATIO_18_1, False) # L1/L2 control\n\n# Set stopping mode for precise control\nleft_motors.set_stopping(BRAKE)\nright_motors.set_stopping(BRAKE)\narm_motor.set_stopping(HOLD)\nlift_motor.set_stopping(HOLD)\n\n# Create the competition object\ncompetition = Competition()\n\n# ===============================\n# PRE-AUTONOMOUS\n# ===============================\ndef pre_auton():\n    brain.screen.print(\"Pre-Autonomous Code Running\")\n    brain.screen.new_line()\n    brain.screen.print(\"Initializing robot...\")\n    wait(1, SECONDS)\n    brain.screen.clear_screen()\n    brain.screen.print(\"Ready for Competition\")\n\n# ===============================\n# AUTONOMOUS\n# ===============================\ndef autonomous():\n    brain.screen.clear_screen()\n    brain.screen.print(\"Autonomous: Driving Forward 6 inches\")\n\n    # Convert inches to degrees for 4\" wheel: 1 rev = 12.566\" → 360° = 12.566\"\n    # So: degrees = (6 / 12.566) * 360\n    degrees_to_drive = (6 / 12.566) * 360\n\n    left_motors.spin_for(FORWARD, degrees_to_drive, DEGREES, 50, PERCENT, False)\n    right_motors.spin_for(FORWARD, degrees_to_drive, DEGREES, 50, PERCENT, True)\n\n    left_motors.stop(BRAKE)\n    right_motors.stop(BRAKE)\n\n    brain.screen.new_line()\n    brain.screen.print(\"Autonomous Complete\")\n\n# ===============================\n# DRIVER CONTROL\n# ===============================\ndef usercontrol():\n    brain.screen.clear_screen()\n    brain.screen.print(\"Driver Control Active\")\n\n    while True:\n        # --- Arcade Drive ---\n        forward = -controller.axis3.position()\n        turn = -controller.axis1.position()\n\n        # Deadband\n        if abs(forward) < 5:\n            forward = 0\n        if abs(turn) < 5:\n            turn = 0\n\n        left_speed = forward + turn\n        right_speed = forward - turn\n\n        # Clamp speed to [-100, 100]\n        left_speed = max(min(left_speed, 100), -100)\n        right_speed = max(min(right_speed, 100), -100)\n\n        left_motors.spin(FORWARD, left_speed, PERCENT)\n        right_motors.spin(FORWARD, right_speed, PERCENT)\n\n        # --- Arm Motor (R1/R2) ---\n        if controller.buttonR2.pressing():\n            arm_motor.spin(FORWARD, 100, PERCENT)\n        elif controller.buttonR1.pressing():\n            arm_motor.spin(REVERSE, 100, PERCENT)\n        else:\n            arm_motor.stop()\n\n        # --- Lift Motor (L1/L2) ---\n        if controller.buttonL2.pressing():\n            lift_motor.spin(FORWARD, 100, PERCENT)\n        elif controller.buttonL1.pressing():\n            lift_motor.spin(REVERSE, 100, PERCENT)\n        else:\n            lift_motor.stop()\n\n        wait(0.02, SECONDS)\n\n# ===============================\n# SET COMPETITION CALLBACKS\n# ===============================\ncompetition = Competition(usercontrol, autonomous)\n\n# Run pre-auton once before match starts\npre_auton()\n","textLanguage":"python","robotConfig":[],"slot":7,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.64.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}