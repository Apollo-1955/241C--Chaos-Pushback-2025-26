from vex import *
import urandom
import math

# Brain should be defined by default
brain=Brain()

# Robot configuration code


# wait for rotation sensor to fully initialize
wait(30, MSEC)


# Make random actually random
def initializeRandomSeed():
    wait(100, MSEC)
    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()
    urandom.seed(int(random))
      
# Set random seed 
initializeRandomSeed()


def play_vexcode_sound(sound_name):
    print("VEXPlaySound:" + sound_name)
    wait(5, MSEC)

# add a small delay to make sure we don't print in the middle of the REPL header
wait(200, MSEC)
# clear the console to make sure we don't have the REPL in the console
print("\033[2J")

#region VEXcode Generated Robot Configuration

# Robot configuration code

# wait for rotation sensor to fully initialize
wait(30, MSEC)


# add a small delay to make sure we don't print in the middle of the REPL header
wait(200, MSEC)
# clear the console to make sure we don't have the REPL in the console
print("\033[2J")

# -------------------
# ---------------------------
# Drive Motors
# ---------------------------
left_motors = MotorGroup(
    Motor(Ports.PORT11, GearSetting.RATIO_18_1, False),
    Motor(Ports.PORT12, GearSetting.RATIO_18_1, False),
    Motor(Ports.PORT13, GearSetting.RATIO_18_1, False)
)

right_motors = MotorGroup(
    Motor(Ports.PORT1, GearSetting.RATIO_18_1, True),
    Motor(Ports.PORT2, GearSetting.RATIO_18_1, True),
    Motor(Ports.PORT3, GearSetting.RATIO_18_1, True)
)

# ---------------------------
# Arm and Lift Motors
# ---------------------------
arm_motor = Motor(Ports.PORT4, GearSetting.RATIO_18_1, False)
lift_motor = Motor(Ports.PORT17, GearSetting.RATIO_18_1, False)

# ---------------------------
# Piston on 3-wire Port A
# ---------------------------
piston = DigitalOut(brain.three_wire_port.a)

# ---------------------------
# Stopping modes
# ---------------------------
left_motors.set_stopping(BRAKE)
right_motors.set_stopping(BRAKE)
arm_motor.set_stopping(HOLD)
lift_motor.set_stopping(HOLD)

# ---------------------------
# Random Seed Initialization
# --------------------------

# ---------------------------
# Pre-Autonomous
# ---------------------------
def pre_auton():
    brain.screen.print("Pre-Autonomous Code Running")
    brain.screen.new_line()
    brain.screen.print("Initializing robot...")
    wait(1, SECONDS)
    brain.screen.clear_screen()
    brain.screen.print("Locked-in")

# ---------------------------
# Autonomous
# ---------------------------
def autonomous():
    brain.screen.clear_screen()
    brain.screen.print("Auton: Drive + Intake")

    # Wheel travel calculation (10 inches)
   

    # Start arm/intake spinning (NON-BLOCKING, continuous)
    arm_motor.spin(FORWARD, 100, PERCENT)

    # Wait long enough for the drive to finish
    wait(30, SECONDS)  # adjust if needed
    left_motors.stop(BRAKE)
    right_motors.stop(BRAKE)


    # Stop drive

    # Optional: stop arm after driving
    arm_motor.stop()

    brain.screen.new_line()
    brain.screen.print("Auton Complete")

# ---------------------------
# Driver Control
# ---------------------------
def usercontrol():
    brain.screen.clear_screen()
    brain.screen.print("Willy Mode")

    piston_state = False
    last_A_state = False

    while True:
        # --- Arcade Drive ---
        forward = -controller.axis3.position()
        turn = -controller.axis1.position()

        if abs(forward) < 5:
            forward = 0
        if abs(turn) < 5:
            turn = 0

        left_speed = max(min(forward + turn, 100), -100)
        right_speed = max(min(forward - turn, 100), -100)

        left_motors.spin(FORWARD, left_speed, PERCENT)
        right_motors.spin(FORWARD, right_speed, PERCENT)

        # --- Arm ---
        if controller.buttonR2.pressing():
            arm_motor.spin(FORWARD, 100, PERCENT)
        elif controller.buttonR1.pressing():
            arm_motor.spin(REVERSE, 100, PERCENT)
        else:
            arm_motor.stop()

        # --- Lift ---
        if controller.buttonL2.pressing():
            lift_motor.spin(FORWARD, 100, PERCENT)
        elif controller.buttonL1.pressing():
            lift_motor.spin(REVERSE, 100, PERCENT)
        else:
            lift_motor.stop()

        # --- Piston Toggle (Button A) ---
        current_A = controller.buttonA.pressing()
        if current_A and not last_A_state:
            piston_state = not piston_state
            piston.set(piston_state)

        last_A_state = current_A

        wait(0.02, SECONDS)

# ---------------------------
# Competition Callbacks
# ---------------------------
competition = Competition(usercontrol, autonomous)

# Run Pre-Autonomous
pre_auton()
