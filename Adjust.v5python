from vex import *
import urandom
import math

# Brain should be defined by default
brain=Brain()

# Robot configuration code


# wait for rotation sensor to fully initialize
wait(30, MSEC)


# Make random actually random
def initializeRandomSeed():
    wait(100, MSEC)
    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()
    urandom.seed(int(random))
      
# Set random seed 
initializeRandomSeed()


def play_vexcode_sound(sound_name):
    print("VEXPlaySound:" + sound_name)
    wait(5, MSEC)

# add a small delay to make sure we don't print in the middle of the REPL header
wait(200, MSEC)
# clear the console to make sure we don't have the REPL in the console
print("\033[2J")

#endregion VEXcode Generated Robot Configuration


# ===============================
# USER CONFIGURATION SECTION
# ===============================

# Create controller
controller = Controller()

# Motors
arm_motor = Motor(Ports.PORT10, GearSetting.RATIO_18_1, False)  # R1/R2 control
lift_motor = Motor(Ports.PORT6, GearSetting.RATIO_18_1, False)  # L1/L2 control


# ===============================
# MAIN LOOP
# ===============================
def when_started1():
    while True:
        # --- Arm Motor (Port 10) ---
        if controller.buttonR1.pressing():
            arm_motor.spin(FORWARD, 100, PERCENT)
        elif controller.buttonR2.pressing():
            arm_motor.spin(REVERSE, 100, PERCENT)
        else:
            arm_motor.stop(HOLD)

        # --- Lift Motor (Port 6) ---
        if controller.buttonL1.pressing():
            lift_motor.spin(FORWARD, 100, PERCENT)
        elif controller.buttonL2.pressing():
            lift_motor.spin(REVERSE, 100, PERCENT)
        else:
            lift_motor.stop(HOLD)

        wait(0.02, SECONDS)  


# Start the control loop
when_started1()
