{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\n\n# ------------------------------------------\n# \n# \tProject:      241C Robotics Code\n#\tAuthor:       Heer Patel\n#\tCreated:      11/6/2025\n#\tDescription:  Vex autonmous and driver code for Pushback\n# \n# ------------------------------------------\n\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\ncontroller=Controller()\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\n\ndef play_vexcode_sound(sound_name):\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n#endregion VEXcode Generated Robot Configuration\n\n\n# ===============================\n# USER CONFIGURATION SECTION\n# ===============================\n\n# Create controller\ncontroller = Controller()\n\n# Motors\narm_motor = Motor(Ports.PORT10, GearSetting.RATIO_18_1, False)  # R1/R2 control\nlift_motor = Motor(Ports.PORT6, GearSetting.RATIO_18_1, False)  # L1/L2 control\n\n\n# ===============================\n# MAIN LOOP\n# ===============================\ndef when_started1():\n    while True:\n        # --- Arm Motor (Port 10) ---\n        if controller.buttonR1.pressing():\n            arm_motor.spin(FORWARD, 100, PERCENT)\n        elif controller.buttonR2.pressing():\n            arm_motor.spin(REVERSE, 100, PERCENT)\n        else:\n            arm_motor.stop(HOLD)\n\n        # --- Lift Motor (Port 6) ---\n        if controller.buttonL1.pressing():\n            lift_motor.spin(FORWARD, 100, PERCENT)\n        elif controller.buttonL2.pressing():\n            lift_motor.spin(REVERSE, 100, PERCENT)\n        else:\n            lift_motor.stop(HOLD)\n\n        wait(0.02, SECONDS)  \n\n\n# Start the control loop\nwhen_started1()\n","textLanguage":"python","robotConfig":[],"slot":5,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.64.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}